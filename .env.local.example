# Copia questo file in .env.local (MAI committare .env.local -- è già
# in .gitignore) e riempi i valori reali dal tuo progetto Supabase
# (Project Settings > API).

# Chiave pubblica "anon" -- usata da lib/supabaseClient.ts, finisce nel
# bundle del browser, rispetta la RLS (solo lettura su foods_raw/
# nutrient_values/sources/food_matrices_master/retention_factors).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chiave "service_role" -- usata SOLO da lib/supabaseAdmin.ts (Server
# Actions del pannello /admin/data-entry), bypassa la RLS. Non deve MAI
# avere il prefisso NEXT_PUBLIC_ e non deve mai finire nel browser.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Password del pannello /admin/data-entry (vedi commento in
# app/admin/data-entry/actions.ts -- un solo amministratore, niente
# multi-utente).
ADMIN_PASSWORD=

# Chiave personale USDA FoodData Central -- usata SOLO da
# scripts/verify_golden_set_batch.ts (Fase 4 punto 15, docs/PRD.md §9).
# Gratuita, istantanea via email: fdc.nal.usda.gov/api-key-signup.html.
# NON usare la DEMO_KEY per questo script: va in HTTP 429 (rate limit)
# quasi subito su un batch di più di pochi alimenti.
USDA_FDC_API_KEY=
